{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagavibes.local/contracts/site-graph.schema.json",
  "title": "SagaVibes Site Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_id",
    "project_id",
    "version",
    "name",
    "active_page_id",
    "design_tokens",
    "pages",
    "nodes"
  ],
  "properties": {
    "site_id": { "type": "string" },
    "project_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "active_page_id": { "type": "string" },
    "design_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography", "radius", "spacing"],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "typography": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "radius": { "type": "string" },
        "spacing": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slug", "node_ids"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "node_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "props", "style"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["hero", "metrics", "services", "cta"] },
          "label": { "type": "string" },
          "props": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tone", "align", "emphasis", "density"],
            "properties": {
              "tone": { "enum": ["base", "muted", "accent"] },
              "align": { "enum": ["left", "center"] },
              "emphasis": { "enum": ["standard", "strong"] },
              "density": { "enum": ["compact", "comfortable", "spacious"] }
            }
          }
        }
      }
    }
  }
}
